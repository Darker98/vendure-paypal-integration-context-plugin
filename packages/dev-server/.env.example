# PayPal Integration
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set to 'production' for live payments; defaults to 'sandbox'
PAYPAL_ENVIRONMENT=sandbox
# Storefront URLs PayPal redirects to after buyer approves / cancels
PAYPAL_RETURN_URL=http://localhost:4200/checkout/payment
PAYPAL_CANCEL_URL=http://localhost:4200/checkout/payment
